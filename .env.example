# BioTailr AI - Environment Variables Example
# NOTE: API keys are now managed per-user via the in-app Setup Wizard.
# Users enter their own keys after first login (stored in browser localStorage).
# This .env file is only needed for local server-side configuration (optional).

# Server Port (optional, defaults to 8181)
PORT=8181

# SMTP Configuration for server-side email (optional - EmailJS preferred)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your-email@example.com
